{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-wakelock"],
  "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1",
  "default_agent": "plan",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-west-2",
        "profile": "default"
      }
    }
  },
  "mcp": {
    "builder-mcp": {
      "type": "local",
      "command": [
        "{env:HOME}/.toolbox/bin/builder-mcp",
        "--include-tools",
        "InternalCodeSearch,InternalSearch,ReadInternalWebsites,WorkspaceSearch,WorkspaceGitDetails,BrazilBuildAnalyzerTool"
      ],
      "enabled": false
    },
    "ellis": {
      "type": "local",
      "command": ["{env:HOME}/go/bin/muse", "listen"],
      "enabled": false,
      "timeout": 120000,
      "environment": {
        "MUSE_MODEL": "us.anthropic.claude-opus-4-6-v1"
      }
    }
  },
  "instructions": [],
  "tools": {
    "builder-mcp_*": true,
    "ellis_*": true
  },
  "agent": {
    "build": {
      "permission": {
        "doom_loop": "deny",
        "external_directory": "deny",
        "question": "deny"
      }
    },
    "explore": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6"
    }
  }
}
