{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-wakelock",
    "opencode-beads"
  ],
  "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1",
  "default_agent": "plan",
  // LSP disabled: full workspace diagnostics stored in context on every edit,
  // consuming 40%+ of context on large Go projects (gopls). See anomalyco/opencode#6310.
  "lsp": false,
  "compaction": {
    "prune": true
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-west-2",
        "profile": "default"
      }
    }
  },
  "mcp": {
    "builder-mcp": {
      "type": "local",
      "command": [
        "{env:HOME}/.toolbox/bin/builder-mcp",
        "--include-tools",
        "InternalCodeSearch,InternalSearch,ReadInternalWebsites,WorkspaceSearch,WorkspaceGitDetails,BrazilBuildAnalyzerTool"
      ],
      "enabled": false
    },
    "ellis": {
      "type": "local",
      "command": ["{env:HOME}/go/bin/muse", "listen"],
      "enabled": false,
      "timeout": 120000,
      "environment": {
        "MUSE_MODEL": "us.anthropic.claude-opus-4-6-v1"
      }
    }
  },
  "permission": {
    "todowrite": "deny"
  },
  "instructions": [],
  "tools": {
    "builder-mcp_*": true,
    "ellis_*": true
  },
  "agent": {
    "build": {
      "variant": "medium",
      "permission": {
        "doom_loop": "deny",
        "external_directory": "deny",
        "question": "deny"
      }
    },
    "plan": {
      "variant": "medium"
    },
    "explore": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-4-6"
    },
    "muse": {
      "description": "Your design instincts and thinking patterns. Consult on design decisions, naming, and architectural tradeoffs.",
      "mode": "subagent",
      "prompt": "{file:~/.muse/muse.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "task": "deny"
      }
    }
  }
}
