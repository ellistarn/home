#!/bin/bash
set -u

# Find real aws by searching PATH, skipping this shim
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
REAL_AWS=$(which -a aws 2>/dev/null | grep -v "$SELF" | head -1)
if [[ -z "$REAL_AWS" ]]; then
    echo "aws: real binary not found in PATH" >&2
    exit 1
fi
TIMEOUT=600

# Pass through if not "eks get-token"
if [[ "${1:-}" != "eks" || "${2:-}" != "get-token" ]]; then
    exec "$REAL_AWS" "$@"
fi

# Cross-platform mtime
get_mtime() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        stat -f %m "$1"
    else
        stat -c %Y "$1"
    fi
}

CACHE_FILE="/tmp/k8s_token_$(echo "$*" | md5sum | cut -d' ' -f1)"

# Clean up expired cache files
for cache in /tmp/k8s_token_*; do
    [[ -f "$cache" ]] || continue
    AGE=$(($(date +%s) - $(get_mtime "$cache")))
    [[ $AGE -gt $TIMEOUT ]] && rm -f "$cache"
done

# Serve from cache if fresh
if [[ -f "$CACHE_FILE" ]]; then
    AGE=$(($(date +%s) - $(get_mtime "$CACHE_FILE")))
    if [[ $AGE -le $TIMEOUT ]]; then
        cat "$CACHE_FILE"
        exit 0
    fi
fi

# Cache miss — call real aws
TOKEN=$("$REAL_AWS" "$@" 2>&1)
RC=$?
if [[ $RC -eq 0 ]]; then
    echo "$TOKEN" | tee "$CACHE_FILE"
else
    echo "$TOKEN" >&2
    exit $RC
fi
