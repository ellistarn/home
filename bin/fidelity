#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["playwright==1.55.0"]
# ///
"""Read-only Fidelity export: brokerage + cash management (fidelity.com) and the Fidelity Visa (Elan).

  fidelity sync [fidelity] [card] [--manual]
                     Open a browser, wait for you to log in to each site, download CSVs.
                     With no site names, syncs both. --manual skips auto-clicking.
  fidelity summary   Print holdings by account from the latest positions CSV (--json for machine use)

You log in yourself; credentials are never seen or stored. The browser profile in
~/.fidelity/profile persists cookies between runs, so ticking "remember this device"
skips 2FA next time (and login entirely while the site's session lasts).

Each download is attempted automatically. If a page doesn't match what the script
expects, it saves a debug screenshot + HTML and asks you to click Download yourself
(any range/format, as many files as you like); every file you download is saved.

Read-only by construction: the script only visits activity/positions pages and clicks
Download. As a backstop, page loads of trade/transfer/payment/account-opening URLs are
aborted. Output lands in ~/.fidelity/<date>/ with ~/.fidelity/latest pointing at it.

Env:
  FIDELITY_HOME     data + profile dir (default ~/.fidelity)
  FIDELITY_BROWSER  "chrome" (default, uses installed Google Chrome) or a path to a Chromium binary
"""

import csv
import datetime as dt
import json
import os
import re
import sys
import threading
from pathlib import Path

HOME = Path(os.environ.get("FIDELITY_HOME", Path.home() / ".fidelity"))
PROFILE = HOME / "profile"
BASE = "https://digital.fidelity.com/ftgw/digital/portfolio"
CARD = "https://login.fidelityrewards.com/onlineCard"
LOGIN_TIMEOUT_MS = 10 * 60 * 1000
LOAD_TIMEOUT_MS = 2 * 60 * 1000

# Pages that can move money or place orders. Any navigation matching these is aborted.
BLOCKED = re.compile(r"trade|transfer|orderentry|/aox/|billpay|moneymovement|withdraw|makepayment|paybill", re.I)


def log(msg):
    print(f"fidelity: {msg}", file=sys.stderr)


# ---------------------------------------------------------------- sync


def sync(sites=("fidelity", "card"), manual=False, base_url=BASE, card_url=CARD):
    from playwright.sync_api import Error, sync_playwright

    out = HOME / dt.date.today().isoformat()
    out.mkdir(parents=True, exist_ok=True)
    PROFILE.mkdir(parents=True, exist_ok=True)
    os.chmod(HOME, 0o700)

    browser = os.environ.get("FIDELITY_BROWSER", "chrome")
    launch = {"channel": "chrome"} if browser == "chrome" else {"executable_path": browser}

    plan = {
        "fidelity": (
            lambda page: _login_fidelity(page, base_url),
            [("positions", lambda page: _download_positions(page, base_url)),
             ("activity", lambda page: _download_activity(page, base_url))],
        ),
        "card": (
            lambda page: _login_card(page, card_url),
            [("card", _download_card)],
        ),
    }

    missing = []
    with sync_playwright() as p:
        ctx = p.chromium.launch_persistent_context(
            PROFILE, headless=os.environ.get("FIDELITY_HEADLESS") == "1", accept_downloads=True, **launch
        )
        ctx.route("**/*", _guard)
        page = ctx.pages[0] if ctx.pages else ctx.new_page()

        for site in sites:
            login, downloads = plan[site]
            login(page)
            for name, fn in downloads:
                if not manual:
                    try:
                        path = _save(fn(page), out / f"{name}.csv")
                        log(f"saved {path}")
                        continue
                    except Error as e:
                        shot = out / f"debug-{name}.png"
                        page.screenshot(path=shot, full_page=True)
                        (out / f"debug-{name}.html").write_text(page.content())
                        log(f"{name}: automatic download failed ({e.message.splitlines()[0]}); debug in {shot}")
                if not _manual_downloads(ctx, page, name, out):
                    missing.append(name)
        ctx.close()

    latest = HOME / "latest"
    latest.unlink(missing_ok=True)
    latest.symlink_to(out.name)
    if missing:
        log(f"nothing downloaded for: {', '.join(missing)}")
    return 1 if missing else 0


def _guard(route):
    req = route.request
    if req.is_navigation_request() and BLOCKED.search(req.url):
        log(f"blocked navigation to {req.url}")
        return route.abort()
    return route.continue_()


def _manual_downloads(ctx, page, name, out):
    """Save every download the user triggers (in any tab) until they press Enter."""
    saved = []

    def on_download(d):
        suffix = Path(d.suggested_filename).suffix or ".csv"
        dest = out / f"{name}-{len(saved) + 1}{suffix}"
        d.save_as(dest)
        saved.append(dest)
        log(f"saved {dest} ({d.suggested_filename})")

    def attach(pg):
        pg.on("download", on_download)

    for pg in ctx.pages:
        attach(pg)
    ctx.on("page", attach)

    done = threading.Event()
    threading.Thread(target=lambda: (sys.stdin.readline(), done.set()), daemon=True).start()
    log(f"{name}: download it yourself in the browser (widest date range, CSV if offered; "
        "repeat for more ranges). Press Enter here when finished.")
    while not done.is_set():
        page.wait_for_timeout(500)

    for pg in ctx.pages:
        pg.remove_listener("download", on_download)
    ctx.remove_listener("page", attach)
    return saved


def _wait_for_login(page, ready, site):
    if ready():
        return
    log(f"log in to {site} in the browser window (waiting up to 10 minutes)")
    deadline = dt.datetime.now() + dt.timedelta(milliseconds=LOGIN_TIMEOUT_MS)
    while not ready():
        if dt.datetime.now() > deadline:
            raise SystemExit(f"fidelity: timed out waiting for {site} login")
        page.wait_for_timeout(1000)


def _login_fidelity(page, base_url):
    page.goto(f"{base_url}/positions")
    _wait_for_login(page, lambda: "/ftgw/digital/portfolio/" in page.url, "Fidelity")


def _login_card(page, card_url):
    page.goto(f"{card_url}/login.do")
    signed_in = page.get_by_role("link", name=re.compile(r"log ?out|sign ?out", re.I))
    _wait_for_login(page, lambda: signed_in.count() > 0, "the Fidelity Visa (fidelityrewards.com)")


def _download_positions(page, base_url):
    page.goto(f"{base_url}/positions")
    actions = page.get_by_role("button", name="Available Actions")
    actions.wait_for(timeout=LOAD_TIMEOUT_MS)
    actions.click()
    with page.expect_download() as d:
        page.get_by_role("menuitem", name="Download").click()
    return d.value


def _download_activity(page, base_url):
    page.goto(f"{base_url}/activity")
    download = page.get_by_role("button", name=re.compile("download", re.I)).first
    download.wait_for(timeout=LOAD_TIMEOUT_MS)
    _widen_activity_range(page)
    with page.expect_download() as d:
        download.click()
    return d.value


def _widen_activity_range(page):
    # Best effort: the default range is short; pick the widest preset offered (Fidelity caps at 90 days).
    from playwright.sync_api import Error

    try:
        page.get_by_role("button", name=re.compile(r"past \d+ days|time period|date range", re.I)).first.click(timeout=5000)
        page.get_by_text(re.compile(r"past 90 days", re.I)).first.click(timeout=5000)
        page.wait_for_timeout(2000)
    except Error:
        log("couldn't change activity date range; using the page default")


def _download_card(page):
    # Elan's card site: "Download transactions" opens a form with a range and a file format.
    page.get_by_role("link", name=re.compile(r"download", re.I)).or_(
        page.get_by_role("button", name=re.compile(r"download", re.I))
    ).first.click(timeout=LOAD_TIMEOUT_MS)
    for select in page.locator("select").all():
        options = select.locator("option").all_inner_texts()
        csv_opt = next((o for o in options if re.search(r"csv|spreadsheet|comma", o, re.I)), None)
        if csv_opt:
            select.select_option(label=csv_opt)
    with page.expect_download() as d:
        page.get_by_role("button", name=re.compile(r"download", re.I)).last.click()
    return d.value


def _save(download, dest):
    download.save_as(dest)
    return dest


# ---------------------------------------------------------------- summary


def summary(as_json=False):
    path = HOME / "latest" / "positions.csv"
    if not path.exists():
        log(f"no {path}; run `fidelity sync` first")
        return 1
    accounts = parse_positions(path)
    if as_json:
        json.dump(accounts, sys.stdout, indent=2)
        print()
        return 0
    grand = 0.0
    for acct in accounts:
        print(f"\n{acct['name']} ({acct['number']})  ${acct['value']:,.2f}")
        for h in sorted(acct["holdings"], key=lambda h: -h["value"]):
            qty = "" if h["quantity"] is None else f"{h['quantity']:,.3f}"
            print(f"  {h['symbol']:<10} {qty:>14} {h['value']:>14,.2f}  {h['description']}")
        grand += acct["value"]
    print(f"\nTotal  ${grand:,.2f}")
    return 0


def parse_positions(path):
    """Group a Fidelity positions CSV into accounts; skips the trailing disclaimer rows."""
    accounts = {}
    with open(path, newline="", encoding="utf-8-sig") as f:
        for row in csv.DictReader(f):
            number = (row.get("Account Number") or "").strip()
            symbol = (row.get("Symbol") or "").strip()
            if not number or not symbol or " " in number:
                continue
            acct = accounts.setdefault(
                number, {"number": number, "name": (row.get("Account Name") or "").strip(), "value": 0.0, "holdings": []}
            )
            value = money(row.get("Current Value")) or 0.0
            acct["value"] += value
            acct["holdings"].append(
                {
                    "symbol": symbol.rstrip("*"),
                    "description": (row.get("Description") or "").strip(),
                    "quantity": money(row.get("Quantity")),
                    "last_price": money(row.get("Last Price")),
                    "value": value,
                    "cost_basis": money(row.get("Cost Basis Total")),
                }
            )
    return list(accounts.values())


def money(s):
    s = (s or "").strip().replace("$", "").replace(",", "").replace("+", "")
    try:
        return float(s)
    except ValueError:
        return None


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "sync":
        sites = tuple(a for a in argv[2:] if a in ("fidelity", "card")) or ("fidelity", "card")
        return sync(sites, manual="--manual" in argv)
    if cmd == "summary":
        return summary(as_json="--json" in argv)
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
