[user]
	name = Ellis Tarn
	email = ellistarn@gmail.com
	signingkey = ~/.ssh/id_ecdsa.pub

[core]
	pager = less -FMRiX
	editor = vim
	excludesfile = ~/.gitignore.global

[push]
	default = simple
	autoSetupRemote = true

[alias]
	graph = log --graph --all --pretty=format:\"%C(yellow)%h%Creset%C(cyan)%C(bold)%d%Creset %C(cyan)(%cr)%Creset %C(green)%<(12)%cn%Creset %s\"

[color]
	ui = auto

[credential]
	UseHttpPath = true

[gpg]
	format = ssh

[includeIf "gitdir:~/workspaces/"]
	path = ~/.gitconfig-amazon
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
